  {
    "id": "lab5-bai3-normalize",
    "type": "function",
    "z": "lab5-bai3-flow",
    "name": "Extract temperature/humidity",
    "func": "const outputs = [[], [], [], []];\nlet payload = msg.payload;\nif (typeof payload === 'string') { try { payload = JSON.parse(payload); } catch (error) { node.warn('Bo qua payload khong phai JSON: ' + error.message); return outputs; } }\nfunction toNumber(value) { if (typeof value === 'number') return Number.isFinite(value) ? value : null; if (typeof value === 'string' && value.trim() !== '') { const number = Number(value); return Number.isFinite(number) ? number : null; } return null; }\nfunction addSample(sensorId, sample, receivedAt) { if (!sample || typeof sample !== 'object') return; const timestamp = sample.timestamp || receivedAt || new Date().toISOString(); const temperature = toNumber(sample.temperature); const humidity = toNumber(sample.humidity); if (temperature !== null) { outputs[0].push({ topic: sensorId, sensor_id: sensorId, timestamp: timestamp, payload: temperature }); outputs[1].push({ topic: sensorId, sensor_id: sensorId, timestamp: timestamp, payload: temperature }); } if (humidity !== null) { outputs[2].push({ topic: sensorId, sensor_id: sensorId, timestamp: timestamp, payload: humidity }); outputs[3].push({ topic: sensorId, sensor_id: sensorId, timestamp: timestamp, payload: humidity }); } }\nif (msg.topic === 'gateway/aggregated_report' && payload && payload.sensors) { Object.entries(payload.sensors).forEach(([sensorId, records]) => { if (!Array.isArray(records)) return; records.forEach((record) => { const sample = record && record.data ? record.data : record; addSample(sensorId, sample, record && record.received_at); }); }); } else { const parts = String(msg.topic || '').split('/'); const sensorId = parts.length >= 3 && parts[0] === 'sensor' ? parts[1] : 'gateway'; addSample(sensorId, payload, msg.received_at); }\nreturn outputs;",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
