  {"id":"cmd","type":"function","z":"b5","name":"Tạo lệnh điều khiển","func":"msg.topic='home/living_room/control';msg.payload=JSON.stringify({command:String(msg.payload)});return msg;","outputs":1,"noerr":0,"x":900,"y":520,"wires":[["out"]]},
