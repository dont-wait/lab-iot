  {"id":"tc","type":"ui_chart","z":"b5","name":"Lịch sử nhiệt độ","group":"sens","order":3,"width":6,"height":5,"label":"Nhiệt độ theo thời gian","chartType":"line","legend":"true","xformat":"HH:mm:ss","interpolate":"linear","nodata":"Đang chờ dữ liệu","ymin":"0","ymax":"50","removeOlder":1,"removeOlderUnit":"3600","colors":["#f97316","#2563eb","#16a34a"],"x":650,"y":240,"wires":[[]]},
