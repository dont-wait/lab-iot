  {"id":"sin","type":"mqtt in","z":"b5","name":"Dữ liệu cảm biến","topic":"home/living_room/sensor","qos":"0","datatype":"auto-detect","broker":"broker","nl":false,"rap":true,"rh":0,"inputs":0,"x":140,"y":100,"wires":[["parse"]]},
  {"id":"parse","type":"function","z":"b5","name":"Tách và chuẩn hóa sensor","func":"let p=msg.payload;if(typeof p==='string'){try{p=JSON.parse(p)}catch(e){return [null,null,null,null]}};let d=p.device_id||'ESP32_NODE_01';return [{payload:Number(p.temperature),topic:d},{payload:Number(p.humidity),topic:d},{payload:d},{payload:new Date().toLocaleTimeString('vi-VN')}];","outputs":4,"noerr":0,"x":350,"y":100,"wires":[["tg","tc"],["hg","hc"],["device"],["time"]]},
  {"id":"tin","type":"mqtt in","z":"b5","name":"Trạng thái đèn","topic":"home/living_room/status","qos":"0","datatype":"auto-detect","broker":"broker","nl":false,"rap":true,"rh":0,"inputs":0,"x":140,"y":180,"wires":[["status"]]},
  {"id":"status","type":"function","z":"b5","name":"Cập nhật trạng thái","func":"let p=msg.payload;if(typeof p==='string'){try{p=JSON.parse(p)}catch(e){return [null,null]}};let on=p.led==='ON';return [{payload:on},{payload:on?'Đang bật':'Đang tắt'}];","outputs":2,"noerr":0,"x":350,"y":180,"wires":[["sw"],["ledtext"]]},
