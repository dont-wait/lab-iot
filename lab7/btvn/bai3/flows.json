  {
    "id": "template-control",
    "type": "ui_template",
    "z": "bai3-tab",
    "group": "ui-group-control",
    "name": "Điều khiển + quản lý người dùng",
    "order": 1,
    "width": 12,
    "height": 0,
    "format": "<div class=\"iot-control\" id=\"iot-control\">\n  <div class=\"iot-userbar\">\n    <strong id=\"iot-user-name\">Đang xác thực phiên...</strong>\n    <span class=\"iot-pill\" data-tone=\"role\" id=\"iot-user-role\">--</span>\n    <span class=\"iot-spacer\"></span>\n    <button class=\"iot-btn\" data-variant=\"ghost\" id=\"iot-logout\" type=\"button\">Đăng xuất</button>\n  </div>\n\n  <div class=\"iot-lock\" id=\"iot-lock\" hidden>\n    <span style=\"font-size:20px;line-height:1\">🔒</span>\n    <span>\n      <strong id=\"iot-lock-title\">Chế độ chỉ xem</strong>\n      <span id=\"iot-lock-text\">Tài khoản của bạn không có quyền điều khiển thiết bị.</span>\n    </span>\n  </div>\n\n  <div class=\"iot-actions\" id=\"iot-actions\">\n    <button class=\"iot-btn\" data-variant=\"primary\" data-action=\"ON\" type=\"button\">🟡 Bật đèn</button>\n    <button class=\"iot-btn\" data-action=\"OFF\" type=\"button\">⚫ Tắt đèn</button>\n    <button class=\"iot-btn\" data-variant=\"warning\" data-action=\"TOGGLE\" type=\"button\">🔄 Đảo trạng thái</button>\n  </div>\n  <p class=\"iot-msg\" id=\"iot-control-msg\" role=\"status\"></p>\n\n  <section id=\"iot-admin\" hidden>\n    <h4 class=\"iot-section-title\">Quản lý người dùng</h4>\n    <table class=\"iot-table\">\n      <thead><tr><th>Tài khoản</th><th>Vai trò</th><th>Quyền chính</th></tr></thead>\n      <tbody id=\"iot-users\"></tbody>\n    </table>\n    <p class=\"iot-note\" id=\"iot-users-note\"></p>\n  </section>\n  <section id=\"iot-admin-only\" hidden>\n    <p class=\"iot-note\">Danh sách tài khoản chỉ hiển thị với vai trò <code>admin</code> (quyền <code>users:read</code>).</p>\n  </section>\n</div>\n\n<script>\n(function () {\n  'use strict';\n  var ROLE_LABEL = { admin: 'Quản trị viên', viewer: 'Chỉ xem', gateway: 'Gateway' };\n  var session = null;\n\n  function $(id) { return document.getElementById(id); }\n\n  function setMessage(text, tone) {\n    var box = $('iot-control-msg');\n    box.textContent = text || '';\n    if (tone) { box.setAttribute('data-tone', tone); } else { box.removeAttribute('data-tone'); }\n  }\n\n  function has(permission) {\n    return Boolean(session && session.permissions && session.permissions.indexOf(permission) !== -1);\n  }\n\n  function setControlsEnabled(enabled) {\n    var buttons = document.querySelectorAll('#iot-actions .iot-btn');\n    for (var i = 0; i < buttons.length; i++) {\n      buttons[i].disabled = !enabled;\n      buttons[i].setAttribute('aria-disabled', String(!enabled));\n      buttons[i].title = enabled ? '' : 'Tài khoản chỉ xem: nút điều khiển đã bị vô hiệu hóa.';\n    }\n  }\n\n  function renderSession() {\n    if (!session) { return; }\n    $('iot-user-name').textContent = session.user.name + ' (' + session.user.username + ')';\n    $('iot-user-role').textContent = ROLE_LABEL[session.user.role] || session.user.role;\n\n    var canControl = has('device:control');\n    var lock = $('iot-lock');\n    if (canControl) {\n      lock.hidden = true;\n      setControlsEnabled(true);\n      setMessage('Tài khoản có quyền device:control: nút điều khiển đang hoạt động.', 'ok');\n    } else {\n      lock.hidden = false;\n      $('iot-lock-title').textContent = 'Chế độ chỉ xem (read-only)';\n      $('iot-lock-text').textContent = 'Vai trò \"' + (ROLE_LABEL[session.user.role] || session.user.role) +\n        '\" không có quyền device:control. Máy chủ sẽ trả về HTTP 403 nếu cố gửi lệnh.';\n      setControlsEnabled(false);\n      setMessage('Nút điều khiển đã bị vô hiệu hóa theo phân quyền.', '');\n    }\n\n    if (has('users:read')) {\n      $('iot-admin').hidden = false;\n      $('iot-admin-only').hidden = true;\n      loadUsers();\n    } else {\n      $('iot-admin').hidden = true;\n      $('iot-admin-only').hidden = false;\n    }\n  }\n\n  function loadUsers() {\n    fetch('/api/rbac/users', { credentials: 'same-origin', cache: 'no-store' })\n      .then(function (response) { return response.ok ? response.json() : Promise.reject(new Error('HTTP ' + response.status)); })\n      .then(function (data) {\n        var body = $('iot-users');\n        body.textContent = '';\n        data.users.forEach(function (user) {\n          var row = document.createElement('tr');\n          var nameCell = document.createElement('td');\n          nameCell.textContent = user.name + ' · ' + user.username;\n          var roleCell = document.createElement('td');\n          roleCell.textContent = ROLE_LABEL[user.role] || user.role;\n          var permCell = document.createElement('td');\n          var roleInfo = data.roles.filter(function (item) { return item.role === user.role; })[0];\n          permCell.textContent = roleInfo ? roleInfo.permissions.join(', ') : '--';\n          row.appendChild(nameCell);\n          row.appendChild(roleCell);\n          row.appendChild(permCell);\n          body.appendChild(row);\n        });\n        $('iot-users-note').textContent = 'Tài khoản được đọc từ users.json; mật khẩu chỉ lưu dạng hash scrypt.';\n      })\n      .catch(function (error) {\n        $('iot-users-note').textContent = 'Không tải được danh sách: ' + error.message;\n      });\n  }\n\n  function sendCommand(action) {\n    if (!session || !has('device:control')) {\n      setMessage('Bị chặn tại trình duyệt: tài khoản không có quyền device:control.', 'error');\n      return;\n    }\n    setControlsEnabled(false);\n    fetch('/api/device/control', {\n      method: 'POST',\n      credentials: 'same-origin',\n      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' },\n      body: JSON.stringify({ action: action })\n    })\n      .then(function (response) {\n        return response.json().catch(function () { return {}; }).then(function (data) {\n          if (!response.ok) {\n            throw new Error((data.message || 'Lệnh bị từ chối') + ' (HTTP ' + response.status + ')');\n          }\n          return data;\n        });\n      })\n      .then(function (data) { setMessage('Đã gửi ' + action + '. Trạng thái đèn: ' + data.lamp + '.', 'ok'); })\n      .catch(function (error) { setMessage(error.message, 'error'); })\n      .then(function () { setControlsEnabled(has('device:control')); });\n  }\n\n  document.querySelectorAll('#iot-actions .iot-btn').forEach(function (button) {\n    button.addEventListener('click', function () { sendCommand(button.getAttribute('data-action')); });\n  });\n\n  $('iot-logout').addEventListener('click', function () {\n    fetch('/api/rbac/logout', { method: 'POST', credentials: 'same-origin' }).then(function () {\n      window.location.replace('/login');\n    });\n  });\n\n  fetch('/api/rbac/me', { credentials: 'same-origin', cache: 'no-store' })\n    .then(function (response) {\n      if (response.status === 401) { window.location.replace('/login?next=' + encodeURIComponent('/ui')); return null; }\n      if (!response.ok) { throw new Error('HTTP ' + response.status); }\n      return response.json();\n    })\n    .then(function (data) { if (data) { session = data; renderSession(); } })\n    .catch(function (error) {\n      setMessage('Không xác thực được phiên: ' + error.message, 'error');\n      setControlsEnabled(false);\n    });\n})();\n</script>\n",
