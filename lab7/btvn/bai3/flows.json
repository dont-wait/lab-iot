  {
    "id": "template-sensor",
    "type": "ui_template",
    "z": "bai3-tab",
    "group": "ui-group-sensor",
    "name": "Bảng thông số (mọi vai trò)",
    "order": 1,
    "width": 12,
    "height": 0,
    "format": "<div class=\"iot-sensor\" id=\"iot-sensor\">\n  <div class=\"iot-grid\">\n    <article class=\"iot-card\">\n      <header><span>🌡️ Nhiệt độ</span><span class=\"iot-pill\" id=\"iot-temp-trend\">--</span></header>\n      <div class=\"iot-value\"><span id=\"iot-temp\">--</span><small>°C</small></div>\n    </article>\n    <article class=\"iot-card\">\n      <header><span>💧 Độ ẩm</span><span class=\"iot-pill\" id=\"iot-hum-trend\">--</span></header>\n      <div class=\"iot-value\"><span id=\"iot-hum\">--</span><small>%</small></div>\n    </article>\n    <article class=\"iot-card\">\n      <header><span>💡 Đèn phòng khách</span><span class=\"iot-pill\" id=\"iot-lamp-pill\" data-tone=\"off\">--</span></header>\n      <div class=\"iot-value\" style=\"font-size:22px\" id=\"iot-lamp-text\">Đang chờ dữ liệu</div>\n    </article>\n  </div>\n\n  <div class=\"iot-chart-wrap\">\n    <div class=\"iot-chart-head\">\n      <span class=\"iot-legend\"><i class=\"iot-dot\" style=\"background:#f97316\"></i> Nhiệt độ (°C)</span>\n      <span class=\"iot-legend\"><i class=\"iot-dot\" style=\"background:#06b6d4\"></i> Độ ẩm (%)</span>\n      <span class=\"iot-spacer\" style=\"flex:1\"></span>\n      <span id=\"iot-range\">180 điểm gần nhất</span>\n    </div>\n    <canvas id=\"iot-chart\" width=\"1200\" height=\"260\"></canvas>\n  </div>\n\n  <div class=\"iot-meta\">\n    <span>📟 Thiết bị: <strong id=\"iot-device\">--</strong></span>\n    <span>🕒 Cập nhật: <strong id=\"iot-updated\">--</strong></span>\n    <span id=\"iot-source\"></span>\n  </div>\n</div>\n\n<script>\n(function () {\n  'use strict';\n  var TEMP_COLOR = '#f97316';\n  var HUM_COLOR = '#06b6d4';\n  var state = { history: { temperature: [], humidity: [] } };\n\n  function $(id) { return document.getElementById(id); }\n\n  function fmt(value, digits) {\n    if (value === null || value === undefined || Number.isNaN(value)) { return '--'; }\n    return Number(value).toFixed(digits === undefined ? 1 : digits);\n  }\n\n  function trend(series) {\n    if (!series || series.length < 2) { return '--'; }\n    var delta = series[series.length - 1].v - series[series.length - 2].v;\n    return (delta >= 0 ? '▲ +' : '▼ ') + delta.toFixed(1);\n  }\n\n  function drawChart() {\n    var canvas = $('iot-chart');\n    if (!canvas) { return; }\n    var ctx = canvas.getContext('2d');\n    var width = canvas.width;\n    var height = canvas.height;\n    var pad = 10;\n    ctx.clearRect(0, 0, width, height);\n\n    var styles = getComputedStyle(document.documentElement);\n    var grid = styles.getPropertyValue('--iot-border').trim() || '#dbe3ee';\n    var muted = styles.getPropertyValue('--iot-muted').trim() || '#64748b';\n\n    ctx.strokeStyle = grid;\n    ctx.lineWidth = 1;\n    ctx.globalAlpha = 0.7;\n    for (var row = 1; row <= 3; row++) {\n      var y = pad + ((height - 2 * pad) * row) / 4;\n      ctx.beginPath();\n      ctx.moveTo(pad, y);\n      ctx.lineTo(width - pad, y);\n      ctx.stroke();\n    }\n    ctx.globalAlpha = 1;\n\n    var series = [\n      { points: state.history.temperature || [], min: 0, max: 50, color: TEMP_COLOR },\n      { points: state.history.humidity || [], min: 0, max: 100, color: HUM_COLOR }\n    ];\n    var maxLength = Math.max(series[0].points.length, series[1].points.length);\n    if (maxLength === 0) {\n      ctx.fillStyle = muted;\n      ctx.font = '16px system-ui, sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText('Đang chờ dữ liệu cảm biến...', width / 2, height / 2);\n      return;\n    }\n\n    series.forEach(function (item) {\n      var points = item.points;\n      if (points.length === 0) { return; }\n      ctx.beginPath();\n      ctx.strokeStyle = item.color;\n      ctx.lineWidth = 3;\n      ctx.lineJoin = 'round';\n      var step = points.length > 1 ? (width - 2 * pad) / (points.length - 1) : 0;\n      points.forEach(function (point, index) {\n        var x = pad + step * index;\n        var ratio = Math.min(1, Math.max(0, (point.v - item.min) / (item.max - item.min)));\n        var y = height - pad - ratio * (height - 2 * pad);\n        if (index === 0) { ctx.moveTo(x, y); } else { ctx.lineTo(x, y); }\n      });\n      ctx.stroke();\n    });\n  }\n\n  function render() {\n    var lastTemp = state.history.temperature[state.history.temperature.length - 1];\n    var lastHum = state.history.humidity[state.history.humidity.length - 1];\n    $('iot-temp').textContent = lastTemp ? fmt(lastTemp.v) : '--';\n    $('iot-hum').textContent = lastHum ? fmt(lastHum.v) : '--';\n    $('iot-temp-trend').textContent = trend(state.history.temperature);\n    $('iot-hum-trend').textContent = trend(state.history.humidity);\n\n    var lampOn = state.state && state.state.lamp === 'ON';\n    var pill = $('iot-lamp-pill');\n    pill.textContent = lampOn ? '● Đang bật' : '○ Đang tắt';\n    pill.setAttribute('data-tone', lampOn ? 'on' : 'off');\n    $('iot-lamp-text').textContent = lampOn ? 'Đang bật' : 'Đang tắt';\n    $('iot-lamp-text').style.color = lampOn ? 'var(--iot-ok)' : 'var(--iot-muted)';\n    $('iot-device').textContent = (state.state && state.state.deviceId) || '--';\n    $('iot-updated').textContent = state.state && state.state.updatedAt\n      ? new Date(state.state.updatedAt).toLocaleString('vi-VN')\n      : '--';\n    $('iot-range').textContent = Math.max(state.history.temperature.length, state.history.humidity.length) + ' điểm gần nhất';\n    drawChart();\n  }\n\n  function refresh() {\n    fetch('/api/state', { credentials: 'same-origin', cache: 'no-store' })\n      .then(function (response) {\n        if (response.status === 401) { window.location.replace('/login?next=' + encodeURIComponent('/ui')); return null; }\n        if (!response.ok) { throw new Error('HTTP ' + response.status); }\n        return response.json();\n      })\n      .then(function (data) { if (data) { state = data; render(); } })\n      .catch(function (error) {\n        $('iot-source').textContent = '⚠️ Mất kết nối API: ' + error.message;\n      });\n  }\n\n  refresh();\n  var timer = setInterval(refresh, 3000);\n  window.addEventListener('beforeunload', function () { clearInterval(timer); });\n})();\n</script>\n",
