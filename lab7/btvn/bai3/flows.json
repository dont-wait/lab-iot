  {
    "id": "template-style",
    "type": "ui_template",
    "z": "bai3-tab",
    "group": "ui-group-sensor",
    "name": "CSS giao diện",
    "order": 0,
    "width": 12,
    "height": 0,
    "format": "<style>\n/* Giao dien dung chung cho hai template Dashboard (Lab 7 - Bai 3). */\n:root {\n    --iot-bg: #f8fafc;\n    --iot-card: #ffffff;\n    --iot-border: #dbe3ee;\n    --iot-text: #0f172a;\n    --iot-muted: #64748b;\n    --iot-accent: #0ea5e9;\n    --iot-ok: #16a34a;\n    --iot-warn: #f59e0b;\n    --iot-danger: #dc2626;\n    --iot-radius: 16px;\n}\n\n@media (prefers-color-scheme: dark) {\n    :root {\n        --iot-bg: #0b1220;\n        --iot-card: #111c2e;\n        --iot-border: #1e293b;\n        --iot-text: #e2e8f0;\n        --iot-muted: #94a3b8;\n        --iot-accent: #38bdf8;\n    }\n}\n\n.iot-sensor,\n.iot-control {\n    font-family: ui-sans-serif, system-ui, 'Segoe UI', sans-serif;\n    color: var(--iot-text);\n}\n\n.iot-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n    gap: 14px;\n}\n\n.iot-card {\n    background: var(--iot-card);\n    border: 1px solid var(--iot-border);\n    border-radius: var(--iot-radius);\n    padding: 16px 18px;\n    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);\n}\n\n.iot-card header {\n    font-size: 13px;\n    color: var(--iot-muted);\n    letter-spacing: 0.02em;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n}\n\n.iot-value {\n    font-size: 34px;\n    font-weight: 700;\n    line-height: 1.15;\n    margin-top: 8px;\n    font-variant-numeric: tabular-nums;\n}\n\n.iot-value small {\n    font-size: 15px;\n    font-weight: 500;\n    color: var(--iot-muted);\n    margin-left: 4px;\n}\n\n.iot-pill {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    padding: 4px 10px;\n    border-radius: 999px;\n    font-size: 12px;\n    font-weight: 600;\n    border: 1px solid var(--iot-border);\n    background: rgba(148, 163, 184, 0.14);\n}\n\n.iot-pill[data-tone='on'] {\n    color: #166534;\n    background: rgba(34, 197, 94, 0.16);\n    border-color: rgba(34, 197, 94, 0.4);\n}\n\n.iot-pill[data-tone='off'] {\n    color: var(--iot-muted);\n}\n\n.iot-pill[data-tone='role'] {\n    color: var(--iot-accent);\n    border-color: rgba(14, 165, 233, 0.4);\n    background: rgba(14, 165, 233, 0.12);\n}\n\n.iot-chart-wrap {\n    margin-top: 16px;\n    background: var(--iot-card);\n    border: 1px solid var(--iot-border);\n    border-radius: var(--iot-radius);\n    padding: 12px 14px 8px;\n}\n\n.iot-chart-head {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 14px;\n    align-items: center;\n    font-size: 12px;\n    color: var(--iot-muted);\n    margin-bottom: 6px;\n}\n\n.iot-legend {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n}\n\n.iot-dot {\n    width: 9px;\n    height: 9px;\n    border-radius: 50%;\n    display: inline-block;\n}\n\n.iot-chart-wrap canvas {\n    width: 100%;\n    height: 130px;\n    display: block;\n}\n\n.iot-meta {\n    margin-top: 12px;\n    font-size: 12.5px;\n    color: var(--iot-muted);\n    display: flex;\n    flex-wrap: wrap;\n    gap: 6px 16px;\n    align-items: center;\n}\n\n.iot-userbar {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 10px 14px;\n    padding: 12px 14px;\n    border: 1px solid var(--iot-border);\n    border-radius: var(--iot-radius);\n    background: var(--iot-card);\n    margin-bottom: 14px;\n}\n\n.iot-userbar strong {\n    font-size: 14px;\n}\n\n.iot-userbar .iot-spacer {\n    flex: 1;\n}\n\n.iot-btn {\n    border: 1px solid var(--iot-border);\n    background: var(--iot-card);\n    color: var(--iot-text);\n    border-radius: 10px;\n    padding: 10px 14px;\n    font-size: 13.5px;\n    font-weight: 600;\n    cursor: pointer;\n    transition: transform 0.05s ease, filter 0.15s ease;\n}\n\n.iot-btn:hover:not(:disabled) {\n    filter: brightness(1.05);\n}\n\n.iot-btn:active:not(:disabled) {\n    transform: translateY(1px);\n}\n\n.iot-btn:disabled {\n    cursor: not-allowed;\n    opacity: 0.45;\n    filter: grayscale(0.6);\n}\n\n.iot-btn[data-variant='primary'] {\n    background: linear-gradient(135deg, #0284c7, #0ea5e9);\n    border-color: transparent;\n    color: #f8fafc;\n}\n\n.iot-btn[data-variant='warning'] {\n    background: linear-gradient(135deg, #d97706, #f59e0b);\n    border-color: transparent;\n    color: #1f2937;\n}\n\n.iot-btn[data-variant='ghost'] {\n    background: transparent;\n}\n\n.iot-actions {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n    margin: 4px 0 2px;\n}\n\n.iot-lock {\n    display: flex;\n    gap: 12px;\n    align-items: flex-start;\n    padding: 14px 16px;\n    border-radius: var(--iot-radius);\n    border: 1px solid rgba(245, 158, 11, 0.45);\n    background: rgba(245, 158, 11, 0.12);\n    color: #92400e;\n    font-size: 13.5px;\n    line-height: 1.5;\n    margin-bottom: 12px;\n}\n\n@media (prefers-color-scheme: dark) {\n    .iot-lock {\n        color: #fcd34d;\n    }\n}\n\n.iot-lock strong {\n    display: block;\n    margin-bottom: 2px;\n}\n\n.iot-msg {\n    min-height: 20px;\n    font-size: 13px;\n    color: var(--iot-muted);\n    margin: 10px 0 0;\n}\n\n.iot-msg[data-tone='error'] {\n    color: var(--iot-danger);\n}\n\n.iot-msg[data-tone='ok'] {\n    color: var(--iot-ok);\n}\n\n.iot-section-title {\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    color: var(--iot-muted);\n    margin: 20px 0 8px;\n}\n\n.iot-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 13px;\n}\n\n.iot-table th,\n.iot-table td {\n    text-align: left;\n    padding: 8px 10px;\n    border-bottom: 1px solid var(--iot-border);\n}\n\n.iot-table th {\n    color: var(--iot-muted);\n    font-weight: 600;\n    font-size: 12px;\n}\n\n.iot-note {\n    font-size: 12.5px;\n    color: var(--iot-muted);\n    margin: 6px 0 0;\n}\n\n</style>",
    "storeOutMessages": true,
    "fwdInMessages": true,
    "resendOnRefresh": false,
    "templateScope": "local",
