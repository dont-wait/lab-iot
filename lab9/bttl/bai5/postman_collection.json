{
  "info": {
    "_postman_id": "lab9-bttl-bai5-thingsboard-e2e",
    "name": "Lab 9 - Bài 5: ThingsBoard End-to-End Rule Chain Testing",
    "description": "Bộ sưu tập Postman dùng để kiểm thử chuỗi Rule Chain cảnh báo nhiệt độ và gửi email trên ThingsBoard.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "tb_host",
      "value": "localhost",
      "type": "string"
    },
    {
      "key": "tb_port",
      "value": "8080",
      "type": "string"
    },
    {
      "key": "device_token",
      "value": "YOUR_DEVICE_ACCESS_TOKEN",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Gửi Telemetry Nhiệt độ bình thường (26.5°C)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"temperature\": 26.5,\n  \"humidity\": 60.0\n}"
        },
        "url": {
          "raw": "http://{{tb_host}}:{{tb_port}}/api/v1/{{device_token}}/telemetry",
          "protocol": "http",
          "host": [
            "{{tb_host}}"
          ],
          "port": "{{tb_port}}",
          "path": [
            "api",
            "v1",
            "{{device_token}}",
            "telemetry"
          ]
        },
        "description": "Gửi bản tin telemetry bình thường. Rule Engine sẽ kiểm tra qua Filter Script -> điều kiện False -> lưu timeseries nhưng KHÔNG kích hoạt cảnh báo."
      },
      "response": []
    },
    {
      "name": "2. Gửi Telemetry Nhiệt độ ĐỘT BIẾN VƯỢT NGƯỠNG (40.5°C) -> Trigger Alarm & Email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"temperature\": 40.5,\n  \"humidity\": 45.0\n}"
        },
        "url": {
          "raw": "http://{{tb_host}}:{{tb_port}}/api/v1/{{device_token}}/telemetry",
          "protocol": "http",
          "host": [
            "{{tb_host}}"
          ],
          "port": "{{tb_port}}",
          "path": [
            "api",
            "v1",
            "{{device_token}}",
            "telemetry"
          ]
        },
        "description": "Gửi bản tin telemetry đột biến nhiệt độ >= 40°C. Rule Engine sẽ kiểm tra qua Filter Script -> điều kiện True -> Create Alarm 'High Temperature Alarm' (Severity CRITICAL) -> Format Email qua node To Email -> Gửi email cảnh báo qua node Send Email."
      },
      "response": []
    }
  ]
}
