{
  "info": {
    "name": "Lab 9 - BTVN Bai 1 - Warning vs Critical",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order. HTTP 2xx confirms telemetry accepted only; verify alarm severity, Debug events and email in ThingsBoard."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "device_token",
      "value": "YOUR_DEVICE_ACCESS_TOKEN"
    }
  ],
  "item": [
    {
      "name": "01 - Normal 29.9 C",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"temperature\": 29.9\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/{{device_token}}/telemetry",
        "description": "No alarm action; no email."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Telemetry endpoint accepted request\", function () {",
              "  pm.expect(pm.response.code).to.be.within(200, 299);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Warning lower boundary 30 C",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"temperature\": 30\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/{{device_token}}/telemetry",
        "description": "WARNING alarm; no email."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Telemetry endpoint accepted request\", function () {",
              "  pm.expect(pm.response.code).to.be.within(200, 299);",
              "});"
            ]
          }
        }
      ]
    },
