        "debugMode": true,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "metadata.alertTemperature = String(msg.temperature);\nmetadata.alertDevice = metadata.deviceName || 'Unknown device';\nreturn {msg: msg, metadata: metadata, msgType: msgType};"
        },
        "additionalInfo": {
          "layoutX": 1020,
          "layoutY": 160
        }
      },
      {
        "type": "org.thingsboard.rule.engine.action.TbCreateAlarmNode",
