          "scriptLang": "JS",
          "jsScript": "return msg.temperature > 35;"
        },
        "additionalInfo": {
          "layoutX": 720,
          "layoutY": 200
        }
      },
      {
        "type": "org.thingsboard.rule.engine.filter.TbJsFilterNode",
        "name": "Warning: 30 <= temperature <= 35?",
        "debugMode": true,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "return msg.temperature >= 30 && msg.temperature <= 35;"
        },
        "additionalInfo": {
          "layoutX": 1020,
          "layoutY": 400
        }
      },
