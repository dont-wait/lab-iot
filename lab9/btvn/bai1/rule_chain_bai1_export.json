      },
      {
        "type": "org.thingsboard.rule.engine.filter.TbJsFilterNode",
        "name": "Valid temperature?",
        "debugMode": true,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "return typeof msg.temperature === 'number' && isFinite(msg.temperature);"
        },
        "additionalInfo": {
          "layoutX": 420,
          "layoutY": 240
        }
      },
