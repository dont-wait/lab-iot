{
  "ruleChain": {
    "name": "Smart_Environment_Alert",
    "type": "CORE",
    "firstRuleNodeId": null,
    "root": false,
    "debugMode": false,
    "configuration": null,
    "additionalInfo": {
      "description": "BTVN Bai 2 - True -> Build Telegram Message -> REST API Call (Telegram sendMessage)"
    }
  },
  "metadata": {
    "version": 1,
    "firstNodeIndex": 0,
    "nodes": [
      {
        "type": "org.thingsboard.rule.engine.filter.TbMsgTypeSwitchNode",
        "name": "Message Type Switch",
        "debugSettings": null,
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "version": 0
        },
        "additionalInfo": {
          "layoutX": 250,
          "layoutY": 200
        }
      },
      {
        "type": "org.thingsboard.rule.engine.telemetry.TbMsgTimeseriesNode",
        "name": "Save Timeseries",
        "debugSettings": null,
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "defaultTTL": 0
        },
        "additionalInfo": {
          "layoutX": 550,
          "layoutY": 50
        }
      },
      {
        "type": "org.thingsboard.rule.engine.filter.TbJsFilterNode",
        "name": "Check Temperature > 35",
        "debugSettings": null,
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "return msg.temperature > 35;",
          "tbelScript": "return msg.temperature > 35;"
        },
        "additionalInfo": {
          "layoutX": 550,
          "layoutY": 250
        }
      },
      {
        "type": "org.thingsboard.rule.engine.action.TbLogNode",
        "name": "Log ALERT",
        "debugSettings": null,
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "return 'ALERT: temperature = ' + msg.temperature + ' vuot nguong 35';",
          "tbelScript": "return 'ALERT: temperature = ' + msg.temperature + ' vuot nguong 35';"
        },
        "additionalInfo": {
          "layoutX": 850,
          "layoutY": 200
        }
      },
      {
        "type": "org.thingsboard.rule.engine.action.TbLogNode",
        "name": "Log NORMAL",
        "debugSettings": null,
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "return 'NORMAL: temperature = ' + msg.temperature;",
          "tbelScript": "return 'NORMAL: temperature = ' + msg.temperature;"
        },
        "additionalInfo": {
          "layoutX": 850,
          "layoutY": 350
        }
      },
      {
        "type": "org.thingsboard.rule.engine.transform.TbTransformMsgNode",
        "name": "Build Telegram Message",
        "debugSettings": null,
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "var t = new Date(parseInt(metadata.ts) + 7*3600*1000).toISOString().replace('T',' ').substr(0,19);\nvar text = '\\u26A0\\uFE0F CANH BAO NHIET DO CAO\\n'\n  + 'Thiet bi: ' + metadata.deviceName + '\\n'\n  + 'Nhiet do: ' + msg.temperature + ' C (nguong 35 C)\\n'\n  + 'Thoi gian: ' + t + ' (GMT+7)';\nreturn {msg: {chat_id: '<CHAT_ID>', text: text}, metadata: metadata, msgType: msgType};",
          "tbelScript": "return {msg: msg, metadata: metadata, msgType: msgType};"
        },
        "additionalInfo": {
          "layoutX": 850,
          "layoutY": 50
        }
      },
      {
        "type": "org.thingsboard.rule.engine.rest.TbRestApiCallNode",
        "name": "Send Telegram",
        "debugSettings": null,
        "singletonMode": false,
        "configurationVersion": 2,
        "configuration": {
          "restEndpointUrlPattern": "https://api.telegram.org/bot<BOT_TOKEN>/sendMessage",
          "requestMethod": "POST",
          "headers": {
            "Content-Type": "application/json"
          },
          "useSimpleClientHttpFactory": false,
          "readTimeoutMs": 0,
          "maxParallelRequestsCount": 0,
          "parseToPlainText": false,
          "enableProxy": false,
          "useSystemProxyProperties": false,
          "proxyHost": null,
          "proxyPort": 0,
          "proxyUser": null,
          "proxyPassword": null,
          "proxyScheme": null,
          "credentials": {
            "type": "anonymous"
          },
          "ignoreRequestBody": false,
          "maxInMemoryBufferSizeInKb": 256
        },
        "additionalInfo": {
          "layoutX": 1150,
          "layoutY": 50
        }
      },
      {
        "type": "org.thingsboard.rule.engine.action.TbLogNode",
        "name": "Log Telegram Error",
        "debugSettings": null,
        "singletonMode": false,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "return 'TELEGRAM FAILED: ' + JSON.stringify(metadata);",
          "tbelScript": "return 'TELEGRAM FAILED';"
        },
        "additionalInfo": {
          "layoutX": 1450,
          "layoutY": 150
        }
      }
    ],
    "connections": [
      {
        "fromIndex": 0,
        "toIndex": 1,
