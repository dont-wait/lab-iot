        "debugMode": true,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "if (typeof msg.temperature !== 'undefined') {\n    if (msg.temperature >= 40) {\n        return ['High Temperature'];\n    } else if (msg.temperature < 28) {\n        return ['Safe Temperature'];\n    }\n}\nreturn ['Normal Temperature'];"
        },
        "additionalInfo": {
          "layoutX": 380,
          "layoutY": 340
        }
      },
