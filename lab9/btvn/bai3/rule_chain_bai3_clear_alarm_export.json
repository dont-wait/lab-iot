        "debugMode": true,
        "configuration": {
          "scriptLang": "JS",
          "alarmType": "High Temperature Alarm",
          "alarmDetailsBuildJs": "var details = {};\ndetails.temperature = msg.temperature;\ndetails.threshold = 40.0;\ndetails.status = 'ACTIVE';\ndetails.message = 'CẢNH BÁO: Nhiệt độ vượt ngưỡng cho phép: ' + msg.temperature + '°C (>= 40°C)!';\nreturn details;",
          "severity": "CRITICAL",
          "propagate": false,
          "useMessageAlarmData": false,
          "overwriteAlarmDetails": false,
          "relationTypes": []
        },
